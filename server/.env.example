# Luna Blade API — environment (copy to server/.env)

# Port for the Express API. The Vite dev server proxies /api -> :3001.
PORT=3001

# Network: testalbatross (testnet) for this round. mainnet requires real funding.
NIMIQ_NETWORK=testalbatross
# Override RPC, e.g. https://test.nimiqwatch.com (auto-derived from NIMIQ_NETWORK otherwise)
#NIMIQ_RPC_URL=https://test.nimiqwatch.com

# REQUIRED: secure random string for JWT signing. Generate with: openssl rand -base64 32
JWT_SECRET=CHANGE_ME_TO_A_SECURE_RANDOM_STRING

# Comma-separated allowed browser origins (the Vite dev server).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Tier 2 automated payouts — signer wallet on the SAME network.
# Generate a testnet key with @nimiq/core and fund it on testalbatross.
#NIM_PAYOUT_PRIVATE_KEY=
# Wallet allowed to POST /api/payouts/trigger-run without ALLOW_PUBLIC_PAYOUT_TRIGGER.
#NIM_PAYOUT_ADDRESS=
# Leave disabled in dev; enable only on a funded demo box.
PAYOUT_CRON_ENABLED=0
PAYOUT_CRON_INTERVAL_MS=60000

# Transaction confirmation timeout when settling payouts (ms).
NIM_TX_CONFIRM_TIMEOUT_MS=120000

# DEV ONLY — skip nothing yet; always 0 in production.
DEV_AUTH_BYPASS=0