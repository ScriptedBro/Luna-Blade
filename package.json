{
  "name": "luna-blade",
  "version": "1.0.0",
  "description": "Luna Blade: The High Forest - 2D Action-Platformer & Survival Arcade for Web & Nimiq Pay Mini Apps",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:all": "concurrently -k -n api,web -c green,cyan \"npm run dev --prefix server\" \"vite\"",
    "build": "vite build",
    "preview": "vite preview",
    "test": "npm test --prefix server",
    "start:server": "npm start --prefix server"
  },
  "keywords": [
    "phaser",
    "platformer",
    "pixelart",
    "nimiq",
    "miniapp"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@nimiq/hub-api": "^1.15.0",
    "@nimiq/identicons": "^1.6.2",
    "@nimiq/mini-app-sdk": "^0.1.0",
    "canvas-confetti": "^1.9.4",
    "concurrently": "^10.0.5",
    "phaser": "^4.2.1",
    "vite": "^8.3.0"
  }
}
